# ============================================================
# Air4 Daily Automotive Intelligence — Environment Variables
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง  (ห้าม commit ไฟล์ .env)
# ============================================================

# --- AI (ถ้าไม่ใส่ ระบบจะใช้ Rule-based Fallback อัตโนมัติ) ---
ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-4-8
AI_ENABLED=true
# effort สำหรับวิเคราะห์ข่าวรายข่าว (low = ประหยัด) และสรุปภาพรวมรายวัน
AI_EFFORT_ITEM=low
AI_EFFORT_DAILY=high

# --- แหล่งข่าวเสริม (ไม่จำเป็น ระบบทำงานได้ด้วย RSS อย่างเดียว) ---
NEWS_API_KEY=
SEARCH_API_KEY=

# --- Social listening ---
# Pantip ใช้งานได้ทันที ไม่ต้องตั้งค่าอะไร (robots.txt อนุญาต)
# Facebook: robots.txt ห้าม crawl → ต้องใช้ Graph API Page Access Token
#           เข้าถึงได้เฉพาะเพจที่บริษัทเป็นเจ้าของ/ดูแลเท่านั้น
FACEBOOK_PAGE_TOKEN=
# TikTok: เนื้อหา render ด้วย JS + ToS จำกัดการ scrape → ต้องใช้ Display API
TIKTOK_ACCESS_TOKEN=

# --- Storage (ค่าว่าง = ใช้ JSON file storage แบบ static) ---
DATABASE_URL=

# --- Dashboard ---
DASHBOARD_BASE_URL=

# --- Pipeline tuning ---
MAX_NEWS_PER_SOURCE=20
LOOKBACK_HOURS=48
# โซเชียล (Pantip): กระทู้เก่ายังใช้เป็นสัญญาณตลาดได้ 720 ชม. = 30 วัน
SOCIAL_LOOKBACK_HOURS=720
MIN_RELEVANCE_SCORE=40
PREFILTER_MIN_SCORE=8
MAX_AI_ITEMS_PER_RUN=60
PLAYWRIGHT_ENABLED=false
TIMEZONE=Asia/Bangkok
RETENTION_DAYS=31

# --- Cost control ---
AI_DAILY_BUDGET_USD=2.00
AI_MAX_INPUT_CHARS=1600

# --- Networking ---
HTTP_TIMEOUT_MS=15000
HTTP_MAX_RETRIES=2
PER_DOMAIN_DELAY_MS=1200
USER_AGENT=Air4IntelligenceBot/1.0 (+https://github.com/air4/air4-intelligence; contact: it@air4.co.th)

# --- Logging ---
LOG_LEVEL=info
