{
  "name": "air4-intelligence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Air4 Daily Automotive Intelligence — collect, filter, analyze and visualize automotive news relevant to Air4 International Co., Ltd.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "daily": "tsx scripts/run-daily.ts",
    "collect": "tsx scripts/collect-news.ts",
    "analyze": "tsx scripts/analyze-news.ts",
    "build:dashboard": "tsx scripts/build-dashboard.ts",
    "mock": "tsx scripts/run-mock.ts",
    "serve": "tsx scripts/serve.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:standalone": "tsx scripts/build-standalone.ts",
    "check:feeds": "tsx scripts/check-feeds.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.4",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.3",
    "fast-xml-parser": "^5.2.5",
    "pino": "^9.13.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
